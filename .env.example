# Base URL of the Guest House & Student Hostel Reservation API.
# Must end with a trailing slash — the API client appends "api/v1/<path>".
VITE_APP_BASE_URL=http://localhost:8000/

# Name shown in the header, page titles and documents.
VITE_APP_NAME=StayHub

# ISO 4217 currency code used to format every monetary value.
VITE_APP_CURRENCY=NGN
